# solarpoweredproject.com — deployed via rsync from static/
# 2026-09-06 (tech-SEO audit TS-06/TS-10/TS-14). Replaces the Aug-9 no-store rule:
# HTML now caches 5 min (deploy-time lscache purge remains primary invalidation;
# repeat visitors may see deploys up to 5 min late — accepted trade-off for CDN caching).

# ── www → apex 301 (canonical host consolidation) ──
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.solarpoweredproject\.com [NC]
  RewriteRule ^(.*)$ https://solarpoweredproject.com/$1 [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  # ── Caching ──
  # HTML/sitemap: short TTL, must-revalidate
  <FilesMatch "\.(html?|xml|txt)$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>
  # Fingerprinted assets (design-system.min.<hash>.css, main.<hash>.js): immutable
  <FilesMatch "(\.min\.[a-f0-9]{40,}\.css|\.[a-f0-9]{40,}\.js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Self-hosted fonts: immutable
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Images and other statics
  <FilesMatch "\.(webp|jpe?g|png|svg|gif|ico|css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  # ── Security headers ──
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://app.rybbit.io; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://app.rybbit.io; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
</IfModule>
